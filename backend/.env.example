  PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://127.0.0.1:5500

# SMTP credentials (use a provider App Password or SMTP API credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-provider-app-password
SMTP_FROM=Play-is-School <your-address@gmail.com>

# First admin account, created automatically the first time the server starts
# if no admin exists yet. Change these before first run.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_before_first_run

# Google OAuth client (Google Cloud > APIs & Services > Credentials).
# Shared by Google sign-in and Google Calendar sync.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Optional custom client for Google sign-in. Admins can select it in Authentication & Security Settings.
# The client ID may also be entered in the admin-managed client catalog.
CUSTOM_GOOGLE_CLIENT_ID=
CUSTOM_GOOGLE_CLIENT_SECRET=
# Optional key for encrypting client secrets stored in MongoDB.
# Falls back to JWT_SECRET. Keep this key stable or stored client secrets cannot be decrypted.
#GOOGLE_OAUTH_CLIENT_ENCRYPTION_KEY=

# School-wide and personal Google Calendar connections use this callback.
# Add this exact URL to the OAuth client's "Authorized redirect URIs".
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/api/calendar/google/callback
# Time zone school event times are entered in (IANA name).
SCHOOL_TIME_ZONE=Asia/Manila
# Events have only a start time; this sets their length in Google Calendar (15-1440).
#GOOGLE_CALENDAR_EVENT_DURATION_MINUTES=60
# Optional: separate secret used to encrypt the stored Google refresh token.
# Falls back to JWT_SECRET. Changing it later requires reconnecting Google Calendar.
#GOOGLE_TOKEN_ENCRYPTION_KEY=
